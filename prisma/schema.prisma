// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  profile Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id                String     @id @default(cuid())
  userId            Int        @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Basic info
  firstName         String
  lastName          String
  title             String?
  subtitle          String?
  bio               String?
  profileImage      String?
  
  // Contact info
  email             String?
  phone             String?
  website           String?
  
  // Social media
  linkedin          String?
  facebook          String?
  instagram         String?
  twitter           String?
  tiktok            String?
  snapchat          String?
  whatsapp          String?
  youtube           String?
  
  // Custom buttons
  customButtons     CustomButton[]
  
  // Display settings
  theme             String?     @default("light")
  cardColor         String?
  textColor         String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("profiles")
}

model CustomButton {
  id        String     @id @default(cuid())
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  label     String     // "Explorer mon site web", "Prendre RDV", etc.
  url       String     // Link destination
  order     Int        @default(0) // For ordering buttons
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("custom_buttons")
  @@index([profileId])
}
