# ==============================
# TAPAM CARD — Environment vars
# ==============================

# MariaDB connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/tapam_card"

# Public base URL of the app.
# Local dev value below. MUST be updated to the real production domain
# before generating NFC/QR URLs for physical cards.
APP_URL="http://localhost:3000"

# WhatsApp commercial number used to generate order links.
# Format: international, digits only, no "+" (e.g. 237698955741).
WHATSAPP_NUMBER="237698955741"

# Secret used to sign session tokens (JWT). Generate a long random string.
# e.g. `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"
