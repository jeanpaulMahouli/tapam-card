# ==========================================
# TAPAM CARD — Variables d'environnement
# ==========================================

# Base de données MariaDB (format Prisma)
DATABASE_URL="mysql://tapam_user:tapam_password@localhost:3306/tapam_card"

# URL publique de l'application (utilisée pour générer les URLs de cartes)
# TEMPORAIRE : remplacer par le vrai domaine en production (ex: https://tapam.card)
APP_URL="http://localhost:3000"

# Numéro WhatsApp commercial (format international, sans + ni espaces)
# TEMPORAIRE : à confirmer/corriger, valeur incomplète fournie initialement
WHATSAPP_NUMBER="237698955741"

# Secret utilisé pour signer les sessions/JWT (générer une valeur aléatoire forte)
AUTH_SECRET="changeme-generate-a-strong-random-secret"
